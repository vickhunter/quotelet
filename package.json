{
  "name": "quotelet",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run build:widget && bun run build:web && bun scripts/assemble.ts",
    "build:widget": "bun packages/widget/build.ts",
    "build:web": "cd apps/web && bun run build",
    "serve": "bun scripts/serve.ts",
    "bdd": "NODE_OPTIONS='--import tsx' cucumber-js",
    "sim": "node --import tsx sim/run.ts all",
    "sim:d003": "node --import tsx sim/run.ts d003",
    "sim:d004": "node --import tsx sim/d004.ts",
    "cli": "bun packages/cli/index.ts",
    "eval:aperto": "bun packages/aperto/eval/run.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.0.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@happy-dom/global-registrator": "^20.0.0"
  }
}
